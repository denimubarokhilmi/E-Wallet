<div
  class="offcanvas canvas-right offcanvas-end p-3"
  id="detail-transaksi-isi-saldo"
  style="width: 500px"
>
  <i
    class="back bi bi-arrow-left-circle-fill fs-3 ms-2 mb-2"
    data-bs-toggle="offcanvas"
    data-bs-target="#demos"
  ></i>
  <div
    class="canvas-header-templates offcanvas-header text-center d-flex justify-content-center align-items-center"
  >
    <div class="profile mt-3 mb-3">
      <img src="../img/logoapk.svg" alt="" />
    </div>
  </div>
  <div class="offcanvas-body shadow-lg">
    <div class="p-3">
      <h4 class="text-center mb-3">Detail Transaksi</h4>
      <div class="row">
        <div class="col-md-12 text-secondary">
          <p>
            23 Nov 2024 <span>07:33</span>
            <span class="float-end"
              >ID SYNOX <%= data.bankAccount.numberAcount %>
            </span>
          </p>
        </div>
        <hr />
        <div class="col-md-12 text-secondary">
          <i class="bi bi-check-circle-fill text-success"></i>
          <span>Berhasil diterima</span>
          <h5 class="text-dark mt-3">Isi saldo</h5>
          <p class="bg-info fw-bold text-dark mt-3 p-2">
            Total diterima
            <span class="float-end">20.000</span>
          </p>
          <p>
            Metode pembayaran
            <span class="float-end">Transfer Alfamart</span>
          </p>
          <hr />
          <p>
            ID Transaksi :
            <span class="float-end">77757575</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
