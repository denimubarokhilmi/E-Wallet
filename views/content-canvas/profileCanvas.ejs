<!-- profile -->
<div
  class="offcanvas canvas-right offcanvas-end p-3"
  id="profile"
  style="width: 500px"
>
  <i
    class="back bi bi-arrow-left-circle-fill fs-3 ms-2 mb-2"
    data-bs-toggle="offcanvas"
    data-bs-target="#demos"
  ></i>
  <div
    class="canvas-header-templates offcanvas-header text-center d-flex justify-content-center align-items-center"
  >
    <div class="profile mt-3">
      <i class="bi bi-person-circle fs-3"></i>
      <h4>My Profile</h4>
    </div>
  </div>
  <div class="offcanvas-body shadow">
    <div class="list-group">
      <div class="d-flex justify-content-between p-2">
        <p class="fw-bold fs-5">user name</p>
        <p class="text-secondary"><%= data.name %></p>
      </div>
      <div class="d-flex justify-content-between p-2">
        <p class="fw-bold fs-5">Email</p>
        <p class="text-secondary"><%= data.email %></p>
      </div>
      <div class="d-flex justify-content-between p-2">
        <p class="fw-bold fs-5">Phone</p>
        <p class="text-secondary"><%= data.phone %></p>
      </div>
      <div class="d-flex justify-content-between p-2">
        <p class="fw-bold fs-5">Bank Akun</p>
        <p class="text-secondary"><%= data.bankAccount.numberAcount%></p>
      </div>
    </div>
  </div>
</div>
