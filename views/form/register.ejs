<section class="container-fluid-lg p-4">
  <div class="container p-2">
    <div class="content-form mt-5 shadow">
      <div class="img-form d-flex align-items-center justify-content-center">
        <img
          src="../../img/logoapk.svg"
          alt="img-login"
          class=""
          style="width: 50%"
        />
      </div>

      <div class="body-forms p-3" style="background-color: whitesmoke">
        <div class="d-flex align-items-center mt-5 justify-content-center">
          <div class="row">
            <div class="col-md-12 text-center mb-4">
              <h2 class="display-4">Sign Up</h2>

              <% if (message.length==0) { %>
              <p class="d-none">''</p>
              <% }else{ %>
              <div
                class="toast mt-5 fs-6 text-center bg-danger show toast-custom"
              >
                <div class="toast-header bg-danger text-center">
                  <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="toast"
                  ></button>
                </div>
                <div class="toast-body">
                  <p><%= message %></p>
                </div>
              </div>

              <%} %>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <form action="/register" method="post" class="p-4">
              <div class="form-floating mb-3 mt-3">
                <input
                  type="text"
                  class="form-control form-input"
                  id="name"
                  name="name"
                  placeholder="name.."
                  required
                />
                <label for="name" class="form-label">Name :</label>
              </div>
              <div class="form-floating mb-3 mt-3">
                <input
                  type="email"
                  class="form-control form-input"
                  id="email"
                  name="email"
                  placeholder="email.."
                  required
                />
                <label for="email" class="form-label">Email :</label>
              </div>
              <div class="form-floating mb-3 mt-3">
                <input
                  type="number"
                  class="form-control form-input"
                  id="phone"
                  name="phone"
                  placeholder="phone.."
                  required
                />
                <label for="phone" class="form-label">Phone :</label>
              </div>
              <div class="form-floating mb-3 mt-3">
                <input
                  type="password"
                  class="form-control form-input"
                  id="password"
                  name="password"
                  placeholder="password.."
                  required
                />
                <label for="password" class="form-label">password :</label>
              </div>
              <div class="form-floating mb-3 mt-3">
                <input
                  type="password"
                  class="form-control form-input"
                  id="password2"
                  name="password2"
                  placeholder="password.."
                  required
                />
                <label for="password2" class="form-label"
                  >Confirm password :</label
                >
              </div>
              <button type="submit" class="btn btn-login">Sign Up</button>
            </form>
            <p class="text-center">
              <a href="/login" class="option">Sudah punya akun?</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  const form = document.querySelector("form");
  const btn = document.querySelector(".btn-login");

  form.addEventListener("submit", (event) => {
    btn.disabled = true;

    const span = document.createElement("span");
    span.classList.add(
      "spinner-border",
      "spinner-border-sm",
      "text-light",
      "ms-2"
    );
    btn.appendChild(span);
  });
</script>
