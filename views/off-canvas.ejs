<% let Merchantss=IDMerchant() %> <% if (data.length ==0 ) { %>
<div class="d-none">
  <p></p>
</div>
<% }else{%>

<div
  class="offcanvas canvas-right offcanvas-end p-3"
  id="demos"
  style="width: 500px"
>
  <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>

  <div
    class="offcanvas-header text-center d-flex justify-content-center align-items-center"
  >
    <div class="profile mt-3">
      <img src="../../img/logoapk.svg" alt="" />
    </div>
  </div>
  <div class="content-header-canvas">
    <h4 class="text-center"><%= data.name %></h4>
    <p class="text-center fw-bold mt-2">
      Balance : <%= format( data.bankAccount.balance) %>
    </p>
    <div
      class="balance-in-out mt-4 p-2 text-center d-flex justify-content-around fs-6"
    >
      <div>
        <div class="d-flex align-items-center">
          <i class="bi bi-arrow-up-circle-fill fs-3 text-success"></i>
          <span class="text-secodary ms-3">Uang Masuk</span>
        </div>
        <p class="mt-3">RP : <%= format(data.bankAccount.uangmasuk )%></p>
      </div>
      <div class="border-start border-3 border-dark ms-2 me-3"></div>
      <div>
        <div class="d-flex align-items-center">
          <i class="bi bi-arrow-down-circle-fill fs-3 text-danger"></i>
          <span class="text-secodary ms-3">Uang Keluar</span>
        </div>
        <p class="mt-3">RP : <%= format( data.bankAccount.uangkeluar) %></p>
      </div>
    </div>
  </div>
  <hr />
  <div class="offcanvas-body shadow">
    <div class="list-group">
      <a
        class="list-text border-top list-group-item list-group-item-action"
        data-bs-toggle="offcanvas"
        data-bs-target="#profile"
        ><i class="bi bi-person-circle fs-5 me-2"></i> My Profile</a
      >
      <a
        class="list-text border-top list-group-item list-group-item-action"
        data-bs-toggle="offcanvas"
        data-bs-target="#transaksi"
        ><i class="bi bi-card-checklist fs-5 me-2"></i> Transaksi</a
      >
      <a
        class="list-text border-top list-group-item list-group-item-action"
        data-bs-toggle="offcanvas"
        data-bs-target="#tarik"
        ><i class="bi bi-cash fs-5 me-2"></i> Tarik Uang</a
      >
      <a
        class="list-text border-top list-group-item list-group-item-action"
        data-bs-toggle="offcanvas"
        data-bs-target="#transfer"
        ><i class="bi bi-send fs-5 me-2"></i> Transfer</a
      >
      <a
        class="list-text border-top list-group-item list-group-item-action"
        data-bs-toggle="offcanvas"
        data-bs-target="#isi-saldo"
      >
        <i class="bi bi-plus-circle fs-5 me-2"></i> Isi Saldo
      </a>

      <a
        href="/logout"
        class="list-text border-top list-group-item list-group-item-action"
        ><i class="bi bi-box-arrow-in-right fs-5 me-2"></i>Log Out</a
      >
    </div>
  </div>
</div>
<%} %>

<!-- profile  -->
<%- include('./content-canvas/profileCanvas') %>
<!-- Transaksi  -->
<%- include('./content-canvas/transaksiCanvas') %>

<!--* detail-transaksi -->

<!-- start detail-terima  -->
<%- include('./content-canvas/detail-transaksi/detail-terima') %>
<!-- end detail terima  -->

<!-- start detail transfer  -->
<%- include('./content-canvas/detail-transaksi/detail-transfer') %>

<!-- end detail transfer -->

<!-- detail-tarik-tunai  -->

<!-- detail-isi-saldo  -->

<!-- content canvas  -->
<!-- tarik uang  -->
<%- include('./content-canvas/tarikUangCanvas') %>

<!-- proses tarik uang   -->
<div
  class="offcanvas canvas-right offcanvas-end p-3"
  id="proses"
  style="width: 500px"
>
  <i
    class="back bi bi-arrow-left-circle-fill fs-3 ms-2 mb-2"
    data-bs-toggle="offcanvas"
    data-bs-target="#demos"
  ></i>
  <div
    class="canvas-header-templates offcanvas-header text-center d-flex justify-content-center align-items-center"
  >
    <div class="tarik-tunai mt-3">
      <div class="row">
        <div class="col-md-8 mb-3">
          <p class="float-start">
            Balance : <%= format(data.bankAccount.balance )%>
          </p>
        </div>
        <div class="col-md-12 mb-3">
          <img src="../img/tarik-tunai.png" class="w-25" alt="tarik-tunai" />
        </div>
        <div class="col-md-12 mb-3">
          <button type="button" class="btn btn-light text-primary">
            Tampilkan kode token
          </button>
        </div>
        <div class="col-md-12 mb-3">
          <p class="text-secondary fw-bold">
            Ikuti instruksi dibawah untuk detail cara tarik saldo
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="offcanvas-body shadow">
    <div class="row ps-3">
      <div class="col-md-12">
        <p class="text-secondary fw-bold">cara tarik saldo</p>
      </div>
      <div class="col-md-12 mb-3">
        <img src="../img/alfamart.png" alt="alfamart" style="width: 60px" />
        <img src="../img/indomaret.png" alt="alfamart" style="width: 60px" />
      </div>
      <div class="col-md-12 text-secondary">
        <p>1. Datangi gerai Alfamart,Indomaret terdekat kamu</p>
        <p>
          2. informasikan nomor Handphone anda <%= data.phone %> dan token anda
          pada kasir dan tentukan jumlah yang akan anda tarik
        </p>
        <p>
          3. Apabila token anda habis masa berlakunya,silahkan tekan kembali
          tombol "Tampilkan kode token"
        </p>
        <p>
          4. Tarik tunai hanya bisa dilakukan oleh anda sendiri sebagai pemilik
          asli akun SYNOX
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Transfer -->
<%- include('./content-canvas/transferCanvas') %>
<!-- isi saldo  -->
<%-include('./content-canvas/isiSaldoCanvas') %>
