<section class="contact container-fluid-lg">
    <div class="header-service ">
        <div class="header-img">
            <img src="../img/titik-1.svg" alt="titik-1">
        </div>
        <div class="content-header">
            <h2 class="display-2 fw-bold text-white">Contact Us</h2>
            <p class="text-dark fs-3 text-center">Home Contact Us</p>
        </div>
    </div>
    <div class="section-contact p-2" style="background-color: rgb(241, 246, 250);">
        <div class="container-md mb-5 ">
            <div class="row" style="margin-top: 120px;">
                <div class="col-md-8 p-3">
                    <form action="" class="p-5 border shadow rounded-4" style="background-color: rgb(255, 255, 255);">
                        <h2>Send us a message</h2>
                        <p class="text-secondary fs-5">Give us chance to serve and bring magic to your finance</p>
                        <div class="row ">

                            <div class="col-md-6 pe-4 ">
                                <label for="name" class="fw-bold fs-5">Name *</label>
                                <div class="form-floating mb-3 mt-3">
                                    <input type="text" class="form-control" id="name" placeholder="Enter name"
                                        name="name" style="background-color: aliceblue;">
                                    <label for="name">Name</label>
                                </div>

                            </div>
                            <div class="col-md-6 ">
                                <label for="email" class="fw-bold fs-5">Email *</label>
                                <div class="form-floating mb-3 mt-3">
                                    <input type="email" class="form-control" id="email" placeholder="Enter email"
                                        name="email" style="background-color: aliceblue;">
                                    <label for="email">Email</label>
                                </div>

                            </div>
                            <div class="col-md-12  ">
                                <label for="phone" class="fw-bold fs-5">Phone *</label>
                                <div class="form-floating mb-3 mt-3">
                                    <input type="text" class="form-control" id="phone" placeholder="Enter phone"
                                        name="phone" style="background-color: aliceblue;">
                                    <label for="phone">Phone</label>
                                </div>

                            </div>
                            <div class="col-md-12  ">
                                <label for="comment" class="fw-bold fs-5">Cover Letter *</label>
                                <div class=" mb-3 mt-3">
                                    <textarea class="form-control" rows="7" id="comment" name="text"
                                        placeholder="Comment goes here" style="background-color: aliceblue;"></textarea>
                                </div>

                            </div>

                        </div>
                        <button type="submit" class="btn btn-hover w-100 fs-5 mt-5 p-3 fw-bold">
                            <span class="d-flex align-items-center justify-content-center">
                                Send Message
                                <i class="bi bi-arrow-right ms-2 fs-4"></i>
                            </span>


                        </button>
                    </form>

                </div>
                <div class="col-md-4 p-3">
                    <div class="contact-info p-5 bg-white rounded-4 shadow">
                        <h4 class="fw-bold fs-3">Contact Info</h4>
                        <div class="social-content">
                            <p class="fs-5 mt-4">
                                <span class="me-3">
                                    <i class="bi bi-telephone"></i>
                                </span>
                                <span class="text-secondary">08123456789</span>
                            </p>
                            <p class="fs-5 mt-4">
                                <span class="me-3">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <span class="text-secondary">synox@gmail.com</span>
                            </p>
                            <div class="social mt-5 mb-4 fs-2">
                                <i class="bi bi-whatsapp"></i>
                                <i class="bi bi-facebook"></i>
                                <i class="bi bi-linkedin"></i>
                            </div>
                            <hr>
                            <div class="social-text mt-4">
                                <h4>United States office :</h4>
                                <p class="text-secondary fs-5">Sunshine Business park, Floor No 05A,Sector-94,</p>
                            </div>
                            <div class="social-text mt-4 mb-4">
                                <h4>United Kingdom office:</h4>
                                <p class="text-secondary fs-5">12 Buckingham Rd, thorn Thwaite, HG3 4 TY, UK Contact</p>
                            </div>
                            <hr>
                            <div class="social-text mt-4">
                                <h4>Our Office Open Time :</h4>
                                <p class="text-secondary fs-5">Mon-Sat: 8.00 - 5.00</p>
                                <p class="text-danger fs-5">Sunday: Closed</p>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</section>